{
  "name": "sonda",
  "version": "0.1.0",
  "description": "Sonda - zestaw do tanich testow checi zaplaty (R1): landing, lista, przedsprzedaz, pomiar lejka, werdykt GO/NO-GO.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p test/tsconfig.json",
    "test": "vitest run",
    "check": "npm run typecheck && vitest run && wrangler deploy --dry-run --outdir dist",
    "db:migrate:local": "wrangler d1 migrations apply sonda_db --local",
    "db:migrate:remote": "wrangler d1 migrations apply sonda_db --remote"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261125.1",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.2",
    "wrangler": "^4.168.0"
  }
}
